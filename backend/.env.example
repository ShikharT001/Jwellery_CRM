# ============================================================
# Jewellery ERP SaaS — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------
# Application
# ---------------------------
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-64-char-hex-string-before-production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------
# Database (Supabase PostgreSQL)
# ---------------------------
# Found in: Supabase Dashboard → Project Settings → Database → Connection String
# Use the "Transaction" pooler URL for serverless; "Session" pooler for persistent apps
DATABASE_URL=postgresql+psycopg2://postgres.hdesjjjqmrcwdkufdqer:wBHMJ9wlcRYkwu7s@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# ---------------------------
# Supabase
# ---------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://hdesjjjqmrcwdkufdqer.supabase.co

# ⚠️  NEVER expose these to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ---------------------------
# CORS (comma-separated origins)
# ---------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------
# Super Admin (first-login elevation)
# ---------------------------
# This email will automatically be granted Super Admin privileges on first login
SUPER_ADMIN_EMAIL=macner001@gmail.com

# ---------------------------
# API
# ---------------------------
API_V1_PREFIX=/api/v1

# ---------------------------
# Production (fill these in before deploying)
# ---------------------------
# DATABASE_URL=postgresql+psycopg2://...production-url...
# CORS_ORIGINS=https://yourdomain.com
# DEBUG=false
